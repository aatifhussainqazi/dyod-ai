# DYOD AI Environment Configuration

# Primary AI Provider: Google Gemini Free Tier Only
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FREE_TIER_ONLY=true

# Development & Evaluation Provider: NVIDIA Nemotron (Disabled in production by default)
NVIDIA_API_KEY=
NVIDIA_CHAT_MODEL=nvidia/nemotron-3.5-bolt-e4b
NVIDIA_PARSE_MODEL=nemotron-3.5-parse
NVIDIA_EVALUATION_ENABLED=false

# Excluded providers per PRD:
# MISTRAL_API_KEY= (EXCLUDED: paid usage required)
# DEEPSEEK_API_KEY= (EXCLUDED: paid usage required)
# DEPLOY_COM_API= (EXCLUDED: unverified provider)

# Security and Limits
PORT=3001
ALLOWED_ORIGINS=http://localhost:5173,https://*.vercel.app
MAX_OUTPUT_TOKENS=1200
MAX_REQUEST_SIZE=10000
RATE_LIMIT_MAX_REQUESTS=25
RATE_LIMIT_WINDOW_MS=60000
